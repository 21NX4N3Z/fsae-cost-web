# --- Data source mode ---
# local  = use browser localStorage (works immediately, no backend)
# nocodb = sync to NocoDB which mirrors your Google Sheet (set the vars below)
VITE_DATA_MODE=local

# --- Google Sheets direct sync (path A: web is source of truth) ---
# Service Account JSON, base64-encoded (no newlines). The SA email must be
# shared as Editor on the target spreadsheet.
# Encode:  base64 -w0 path/to/sa.json   (or:  node -e "console.log(Buffer.from(require('fs').readFileSync('sa.json')).toString('base64'))")
VITE_GOOGLE_SA_B64=
# Spreadsheet ID from the Sheet URL:
#   https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
VITE_GOOGLE_SHEET_ID=

# --- NocoDB (only needed when VITE_DATA_MODE=nocodb) ---
# URL of your NocoDB instance, e.g. https://your-nocodb.railway.app
VITE_NOCODB_URL=
# Project API token (Base > Project > Swagger > copy xc-token)
VITE_NOCODB_TOKEN=
# Table IDs auto-detected by name if left blank:
VITE_NOCODB_TABLE_PARTS=
VITE_NOCODB_TABLE_CARS=
VITE_NOCODB_TABLE_DEPTS=
VITE_NOCODB_TABLE_MATERIALS=
VITE_NOCODB_TABLE_PROCESSES=

# --- Currency display ---
# All values stored in the sheet are USD. Display can toggle USD/THB.
VITE_USD_TO_THB=36.5
